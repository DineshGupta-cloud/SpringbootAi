# Server
server.port=8080

# MySQL - use environment variables
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/banking_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# JWT
jwt.secret=${JWT_SECRET:your-256-bit-secret-key-change-this-in-production-must-be-long-enough}
jwt.expiration-ms=86400000

# Spring AI OpenAI
spring.ai.openai.api-key=${OPENAI_API_KEY:sk-your-openai-api-key}
spring.ai.openai.chat.options.model=gpt-4o-mini
spring.ai.openai.chat.options.temperature=0.2

# Logging
logging.level.com.example.banking=INFO
logging.level.org.springframework.security=WARN
